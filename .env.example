# Copy to .env and fill in real values ONLY on your own machine/server.
# Never commit .env. All values below are placeholders.

# ---- General ----
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

# ---- Safety switches (safe defaults) ----
DRY_RUN=true                     # true = never call Instagram write APIs
REVIEW_QUEUE_ENABLED=true        # AI replies wait for your approval in the dashboard
AUTO_REPLY_ENABLED=false         # post replies automatically (requires REVIEW_QUEUE_ENABLED=false)
AUTO_DM_ENABLED=false            # send DMs automatically

# ---- Meta app (Instagram API with Instagram Login) ----
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=       # any long random string; also entered in the Meta dashboard
META_GRAPH_API_BASE_URL=https://graph.instagram.com
META_GRAPH_API_VERSION=v23.0

# ---- Instagram account ----
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=          # long-lived token (expires in ~60 days; refreshed by the app later)
INSTAGRAM_REQUEST_TIMEOUT_SECONDS=15

# ---- Images for DMs ----
PUBLIC_BASE_URL=                 # https URL of this app, e.g. https://my-app.onrender.com
MEDIA_DIR=./media                # files here are PUBLIC at $PUBLIC_BASE_URL/media/<file>

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini         # any chat model; small models keep cost low
OPENAI_MAX_OUTPUT_TOKENS=200
OPENAI_TIMEOUT_SECONDS=20
OPENAI_DAILY_LIMIT=300           # max AI calls per UTC day; extra comments wait in the queue

# ---- AI reply drafting (leave OPENAI_API_KEY empty to use the free offline stub) ----
AI_PROCESSING_ENABLED=true
AI_MIN_CONFIDENCE=0.5            # drafts below this are flagged for careful review
CREATOR_NAME=Creator
CREATOR_PERSONA=A friendly Instagram creator who replies warmly and briefly.
REPLY_EMOJI_ALLOWED=true
REPLY_MENTION_USERNAME=false
DM_OFFER_TEXT=                   # e.g. what to say in DMs when someone asks for price/details
BLOCKED_WORDS=                   # comma-separated; comments containing these are skipped

# ---- Dashboard ----
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=              # required when APP_ENV=production
SESSION_SECRET_KEY=              # required when APP_ENV=production; e.g. `openssl rand -hex 32`
